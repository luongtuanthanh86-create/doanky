<%- include('../partials/header') %>
<div class="page-heading"><h1>Điểm cứu hộ</h1><p>Nhập các cơ sở thực tế. Hệ thống chọn điểm đang hoạt động gần vị trí khách nhất theo khoảng cách đường thẳng.</p></div>
<section class="support-card"><h2><%= values.id ? 'Sửa điểm cứu hộ' : 'Thêm điểm cứu hộ' %></h2>
<form method="post" action="/admin/stations/<%= values.id ? values.id + '/save' : 'save' %>" class="station-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Tên điểm<input name="name" maxlength="150" value="<%= values.name || '' %>" required></label>
  <label>Địa chỉ<input name="address" maxlength="500" value="<%= values.address || '' %>" required></label>
  <label>Số điện thoại<input name="phone" type="tel" value="<%= values.phone || '' %>"></label>
  <div class="coordinate-row"><label>Vĩ độ<input type="number" step="any" name="lat" min="-90" max="90" value="<%= values.lat ?? '' %>" required></label><label>Kinh độ<input type="number" step="any" name="lng" min="-180" max="180" value="<%= values.lng ?? '' %>" required></label></div>
  <p class="muted">Có thể lấy tọa độ bằng cách nhấp chuột phải vào địa điểm trong Google Maps. Nhập vĩ độ trước, kinh độ sau.</p>
  <label><input type="checkbox" name="active" value="1" <%= values.active === undefined || Number(values.active) ? 'checked' : '' %>> Đang hoạt động</label>
  <label><input type="checkbox" name="isDemo" value="1" <%= Number(values.isDemo) ? 'checked' : '' %>> Điểm minh họa, không phải cơ sở thực</label>
  <button class="btn btn-primary">Lưu điểm cứu hộ</button> <% if(values.id){ %><a href="/admin/stations">Hủy chỉnh sửa</a><% } %>
</form></section>
<section class="support-card"><h2>Các điểm đã thêm</h2>
<% if(!stations.length){ %><p>Chưa có điểm nào. Thêm cơ sở thật hoặc dùng điểm mẫu để thử chức năng.</p><% } %>
<div class="table-responsive"><table class="table"><thead><tr><th>Tên / địa chỉ</th><th>Tọa độ</th><th>Trạng thái</th><th></th></tr></thead><tbody>
<% stations.forEach(s=>{ %><tr><td><strong><%= s.name %></strong><br><%= s.address %><br><%= s.phone %><% if(s.isDemo){ %><br><span class="text-warning">DỮ LIỆU MẪU</span><% } %></td><td><%= s.lat %>, <%= s.lng %></td><td><%= s.active ? 'Hoạt động' : 'Tạm ngừng' %></td><td><a class="btn btn-outline-primary" href="/admin/stations/<%= s.id %>/edit">Sửa</a></td></tr><% }) %>
</tbody></table></div>
<form method="post" action="/admin/stations/demo"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline-secondary">Thêm 5 điểm mẫu tại Hà Nội</button></form>
<p class="muted">Điểm mẫu chỉ được dùng khi chưa có điểm thật đang hoạt động. Không có số điện thoại giả.</p>
</section>
<section class="support-card"><h2>Nhân viên thuộc trạm</h2><p>Tài khoản chưa thuộc trạm làm điều phối viên. Phụ trách trạm nhận yêu cầu và cử xe, nhân viên hiện trường cập nhật hành trình.</p>
<form method="post" action="/admin/stations/member" class="station-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Nhân viên<select name="accountId" required><% accounts.forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %> (<%= a.username %>)</option><% }) %></select></label>
<label>Thuộc trạm<select name="stationId"><option value="0">Điều phối viên — không thuộc trạm</option><% stations.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label>
<label><input type="checkbox" name="manager" value="1"> Phụ trách trạm, được nhận yêu cầu và cử xe</label><button class="btn btn-primary">Lưu phân công nhân viên</button></form>
<% members.forEach(m=>{ %><p><strong><%= m.name %></strong> (<%= m.username %>) → <%= m.stationName %> · <%= m.manager ? 'Phụ trách trạm' : 'Nhân viên hiện trường' %></p><% }) %>
</section>
<section class="support-card"><h2>Xe của trạm</h2><form method="post" action="/admin/stations/vehicle" class="station-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Trạm<select name="stationId" required><% stations.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label>
<label>Tên xe<input name="name" maxlength="150" required placeholder="Xe kéo, xe hỗ trợ…"></label><label>Biển số<input name="plate" maxlength="30" required></label><label>Khả năng<input name="capability" maxlength="150" placeholder="Kéo ô tô, kích bình…"></label><button class="btn btn-primary">Thêm xe</button></form>
<% vehicles.forEach(v=>{ %><p><strong><%= v.name %> · <%= v.plate %></strong> → <%= v.stationName %> · <%= v.capability %> · <%= v.active ? 'Hoạt động' : 'Tạm ngừng' %></p><form method="post" action="/admin/stations/vehicle/<%= v.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-light"><%= v.active ? 'Tạm ngừng xe' : 'Mở hoạt động xe' %></button></form><% }) %>
</section><%- include('../partials/footer') %>
