<% const isAdmin = user.vaiTro === 'admin', base = isAdmin ? '/admin' : '/staff'; %>
<div class="page-heading">
  <p class="eyebrow">ĐIỀU PHỐI CỨU HỘ</p>
  <h1><%= title %></h1>
  <p><%= total %> yêu cầu phù hợp</p>
</div>
<section class="panel table-panel">
  <form class="table-filters" method="get" action="<%= base %>/requests">
    <div><label class="form-label" for="status">Trạng thái</label><select class="form-select" id="status"
        name="status">
        <option value="">Tất cả trạng thái</option><% Object.keys(statuses).forEach(key => { %><option
          value="<%= key %>" <%= filters.status === key ? 'selected' : '' %>><%= statuses[key] %></option>
        <% }) %>
      </select></div><% if (isAdmin) { %><div><label for="search" class="form-label">Mã yêu cầu hoặc số điện
        thoại</label><input class="form-control" id="search" name="search" maxlength="30"
        value="<%= typeof filters.search === 'string' ? filters.search : '' %>"
        placeholder="Nhập chính xác mã hoặc SĐT"></div><% } %><button class="btn btn-location">Lọc yêu
      cầu</button><a href="<%= base %>/requests" class="btn btn-outline-secondary">Đặt lại</a>
  </form>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Mã</th>
          <th>Người yêu cầu</th>
          <th>Số điện thoại</th>
          <th>Loại xe</th>
          <th>Sự cố</th><% if (isAdmin) { %><th>Nhân viên</th><% } %><th>Thời gian gửi</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %><tr>
          <td colspan="<%= isAdmin ? 9 : 8 %>" class="text-center py-5 text-secondary">Chưa có yêu cầu phù hợp
            với bộ lọc.</td>
        </tr><% } %>
        <% rows.forEach(request => { %><tr>
          <td><a class="request-id"
              href="<%= base %>/requests/<%= request.MaYeuCau %>">#<%= request.MaYeuCau %></a></td>
          <td><%= request.HoTen %></td>
          <td class="text-nowrap"><%= request.SoDienThoai %></td>
          <td><%= request.LoaiXe %></td>
          <td><%= request.TenLoai %></td><% if (isAdmin) { %><td>
            <%= request.TenNhanVien || 'Chưa phân công' %></td><% } %><td class="text-nowrap">
            <%= formatDate(request.ThoiGianGui) %></td>
          <td><span
              class="status-badge status-<%= request.TrangThai %>"><%= statuses[request.TrangThai] %></span>
          </td>
          <td>
            <div class="table-actions"><a href="<%= base %>/requests/<%= request.MaYeuCau %>"
                class="btn btn-sm btn-outline-secondary">Chi
                tiết</a><% if (!isAdmin && request.TrangThai === 'ChoTiepNhan') { %><form method="post"
                action="/staff/requests/<%= request.MaYeuCau %>/accept"><input type="hidden" name="_csrf"
                  value="<%= csrf %>"><button class="btn btn-sm btn-location">Tiếp nhận</button></form><% } %>
            </div>
          </td>
        </tr><% }) %>
      </tbody>
    </table>
  </div>
  <nav class="pagination-bar" aria-label="Phân trang"><span>Trang <%= page %> / <%= pages %></span>
    <div>
      <% for (const target of [page - 1,page + 1]) { if (target >= 1 && target <= pages) { const params = new URLSearchParams({ page: String(target), status: typeof filters.status === 'string' ? filters.status : '', search: typeof filters.search === 'string' ? filters.search : '' }); %><a
        class="btn btn-sm btn-outline-secondary ms-2"
        href="?<%= params.toString() %>"><%= target < page ? '← Trước' : 'Sau →' %></a><% } } %></div>
  </nav>
</section>
